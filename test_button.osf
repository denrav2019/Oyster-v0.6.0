use "stdlib/tk" as tk

$tk = tk.tk_init()
print("Tk index:")
print($tk)

if($tk >= 0) {
    tk.tk_send($tk, "wm title . Test")
    tk.tk_send($tk, "wm geometry . 400x300")
    tk.tk_send($tk, "button .b1 -text ClickMe -command {puts CLICKED}")
    tk.tk_send($tk, "pack .b1")
    tk.tk_send($tk, "update")

    $event = tk.tk_wait_event($tk, 3000)
    print("Event:")
    print($event)

    tk.tk_close($tk)
}
